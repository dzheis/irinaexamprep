@tailwind base;
@tailwind components;
@tailwind utilities;

/* Lenis smooth scroll */
html.lenis, html.lenis body {
  height: auto;
}

.lenis.lenis-smooth {
  scroll-behavior: auto !important;
}

.lenis.lenis-smooth [data-lenis-prevent] {
  overscroll-behavior: contain;
}

.lenis.lenis-stopped {
  overflow: hidden;
}

/* CSS Variables for Colors */
:root {
  /* Neutrals */
  --color-background: #F556F8;
  --color-light-bg: #E6E8EC;
  --color-secondary-ui: #B88EC8;
  --color-text: #2F3440;
  
  /* Blues */
  --color-accent: #5E6F86;
  --color-cta-button: #4A5A70;
  --color-primary-cta: #39485C;
  
  /* Pinks */
  --color-secondary-accent: #D8A6B0;
  --color-cta-soft: #C58C97;
  
  /* Warm */
  --color-warm-bg: #E7DCD6;
  --color-warm-ui: #C9B7AE;
  
  /* Fonts */
  --font-family-base: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

@keyframes rotate-x {
  0% {
    transform: perspective(400px) rotateX(0deg);
  }
  100% {
    transform: perspective(400px) rotateX(360deg);
  }
}

.hover-rotate-x {
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.hover-rotate-x:hover {
  animation: rotate-x 1.2s cubic-bezier(0.4, 0, 0.2, 1);
}

@layer base {
  body {
    font-family: var(--font-family-base);
    @apply antialiased;
    color: var(--color-text);
    background: transparent;
  }

  html {
    scroll-behavior: smooth;
    background: transparent;
    /* Резервируем место под скроллбар — убирает дёрганье при открытии модального окна */
    scrollbar-gutter: stable;
  }
}

@keyframes gradientShift {
  0% {
    background-position: 0% 50%;
  }
  33% {
    background-position: 100% 50%;
  }
  66% {
    background-position: 50% 100%;
  }
  100% {
    background-position: 0% 50%;
  }
}

.hero-gradient {
  background: 
    linear-gradient(135deg, color-mix(in srgb, #5E6F86 2%, var(--color-light-bg) 98%) 0%, color-mix(in srgb, var(--color-light-bg) 100%, transparent) 50%, transparent 100%),
    linear-gradient(225deg, color-mix(in srgb, #D8A6B0 2%, var(--color-warm-bg) 98%) 0%, color-mix(in srgb, var(--color-warm-bg) 100%, transparent) 50%, transparent 100%),
    linear-gradient(90deg, var(--color-light-bg) 0%, var(--color-warm-bg) 50%, var(--color-light-bg) 100%),
    radial-gradient(ellipse 80% 60% at 20% 30%, color-mix(in srgb, var(--color-secondary-ui) 8%, transparent) 0%, transparent 70%),
    radial-gradient(ellipse 80% 60% at 80% 70%, color-mix(in srgb, var(--color-accent) 6%, transparent) 0%, transparent 70%),
    radial-gradient(ellipse 100% 80% at 0% 50%, color-mix(in srgb, #5E6F86 3%, transparent) 0%, transparent 80%),
    radial-gradient(ellipse 100% 80% at 100% 50%, color-mix(in srgb, #D8A6B0 3%, transparent) 0%, transparent 80%),
    radial-gradient(ellipse 100% 80% at 30% 40%, color-mix(in srgb, var(--color-accent) 5%, transparent) 0%, transparent 60%),
    radial-gradient(ellipse 100% 80% at 70% 60%, color-mix(in srgb, var(--color-secondary-ui) 4%, transparent) 0%, transparent 60%),
    radial-gradient(ellipse 120% 100% at 50% 20%, color-mix(in srgb, var(--color-warm-ui) 3%, transparent) 0%, transparent 65%);
  background-size: 300% 300%, 300% 300%, 200% 200%, 250% 250%, 250% 250%, 300% 300%, 300% 300%, 300% 300%, 320% 320%, 350% 350%;
  animation: gradientShift 30s ease-in-out infinite;
  position: relative;
  overflow: hidden;
}

.hero-gradient::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: url('/icons/hero-pattern.svg');
  background-size: cover;
  background-position: center bottom;
  background-repeat: no-repeat;
  opacity: 0.15;
  pointer-events: none;
  z-index: 0;
  -webkit-filter: blur(2px);
  filter: blur(2px);
}

.hero-gradient::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200px;
  background: linear-gradient(
    to bottom,
    transparent 0%,
    color-mix(in srgb, var(--color-light-bg) 20%, transparent) 30%,
    color-mix(in srgb, var(--color-light-bg) 50%, transparent) 60%,
    color-mix(in srgb, var(--color-light-bg) 80%, transparent) 85%,
    var(--color-light-bg) 100%
  );
  pointer-events: none;
  z-index: 1;
}

footer.hero-gradient::after {
  display: none;
}

/* Main page gradient */
/* Фон страницы: вертикальный SVG между хедером и футером, без повтора */
.gradient-bg {
  background-image: url(/background.svg);
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
  position: relative;
  overflow: hidden;
  min-height: 100%;
}

@layer components {
  .section {
    @apply container mx-auto px-6;
  }

  .hero {
    @apply relative overflow-hidden pt-24 md:pt-28 pb-12 md:pb-16;
    min-height: auto;
    display: flex;
    align-items: center;
  }

  .hero > * {
    position: relative;
    z-index: 2;
  }

  .glass {
    @apply backdrop-blur-2xl shadow-[0_8px_32px_rgba(0,0,0,0.1)] transition-colors duration-300 ease-in-out;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(230, 232, 236, 0.5);
  }

  .card {
    @apply rounded-3xl p-8 shadow-lg transition-colors duration-300 ease-in-out;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(230, 232, 236, 0.5);
    box-shadow: 0 8px 32px rgba(47, 52, 64, 0.1);
  }

  .btn {
    @apply inline-flex items-center justify-center gap-2 rounded-full px-7 py-3 text-base font-semibold transition-all duration-300 min-h-[44px] min-w-[44px];
  }

  .btn-primary {
    @apply btn text-white shadow-lg;
    background: var(--color-primary-cta);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-primary-cta) 35%, transparent);
    transform: translateY(0);
    transition: transform 0.35s ease, background 0.35s ease, box-shadow 0.35s ease;
  }

  .btn-primary:hover {
    background: var(--color-cta-button);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-primary-cta) 40%, transparent);
    transform: translateY(-2px);
  }

  .btn-primary:active {
    transform: translateY(1px);
    box-shadow: 0 1px 4px color-mix(in srgb, var(--color-primary-cta) 40%, transparent);
  }

  .btn-secondary {
    @apply btn border;
    background: rgba(255, 255, 255, 0.6);
    border-color: var(--color-light-bg);
    color: #000000;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-cta-button) 20%, transparent);
    transform: translateY(0);
    opacity: 0.9;
    transition: transform 0.35s ease, opacity 0.35s ease, background 0.35s ease, border-color 0.35s ease, color 0.35s ease, box-shadow 0.35s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.8);
    color: #000000;
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-cta-button) 30%, transparent);
    transform: translateY(-2px);
    opacity: 1;
  }

  .btn-secondary:active {
    transform: translateY(1px);
    box-shadow: 0 1px 6px color-mix(in srgb, var(--color-cta-button) 25%, transparent);
  }

  .badge {
    @apply inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition-colors duration-300 ease-in-out;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid color-mix(in srgb, var(--color-light-bg) 60%, transparent);
    color: var(--color-text);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .nav {
    @apply backdrop-blur-lg border-b;
    background: rgba(255, 255, 255, 0.6);
    border-color: transparent;
  }

  /* Theme: text and borders (replaces inline color/borderColor) */
  .text-theme { color: var(--color-text); }
  .text-theme-accent { color: var(--color-accent); }
  .bg-theme-secondary-accent { background-color: var(--color-secondary-accent); }
  .border-theme-warm-ui { border-color: var(--color-warm-ui); }
  .border-theme-light-bg { border-color: var(--color-light-bg); }
  .border-theme-secondary-accent { border-color: var(--color-secondary-accent); }

  /* Nav links: физическая кнопка, плавные переходы */
  .nav-link {
    color: var(--color-accent);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    background-color: transparent;
    box-shadow: none;
    transform: translateY(0);
    transition: color 0.35s ease, box-shadow 0.35s ease, transform 0.35s ease, background-color 0.35s ease, margin-right 0.35s ease;
  }
  .nav-link:hover {
    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.7);
    box-shadow: 0 4px 14px rgba(47, 52, 64, 0.22);
    transform: translateY(-2px);
    margin-right: 0.5rem;
  }
  .nav-link:active {
    transform: translateY(1px);
    box-shadow: 0 2px 8px rgba(47, 52, 64, 0.15);
  }

  /* Form input: border and focus (replaces inline + onFocus/onBlur) */
  .input-theme {
    border-color: var(--color-light-bg);
    color: var(--color-text);
    --tw-ring-color: var(--color-secondary-accent);
  }
  .input-theme:focus {
    border-color: var(--color-secondary-accent);
    outline: none;
  }

  /* CTA subscribe button (replaces inline + onMouseEnter/onMouseLeave) */
  .btn-cta-subscribe {
    background: var(--color-cta-soft);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-cta-soft) 30%, transparent);
    transform: scale(1);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }
  .btn-cta-subscribe:hover {
    box-shadow: 0 6px 20px color-mix(in srgb, var(--color-cta-soft) 40%, transparent);
    transform: scale(1.05);
  }

  /* Hero image edge overlay */
  .hero-image-overlay {
    background:
      linear-gradient(to top, var(--color-light-bg) 0%, transparent 20px, transparent calc(100% - 20px), var(--color-light-bg) 100%),
      linear-gradient(to bottom, var(--color-light-bg) 0%, transparent 20px, transparent calc(100% - 20px), var(--color-light-bg) 100%),
      linear-gradient(to left, var(--color-light-bg) 0%, transparent 20px, transparent calc(100% - 20px), var(--color-light-bg) 100%),
      linear-gradient(to right, var(--color-light-bg) 0%, transparent 20px, transparent calc(100% - 20px), var(--color-light-bg) 100%);
    mask-image:
      linear-gradient(to top, transparent 0px, transparent 20px, black 40px, black calc(100% - 40px), transparent calc(100% - 20px), transparent 100%),
      linear-gradient(to left, transparent 0px, transparent 20px, black 40px, black calc(100% - 40px), transparent calc(100% - 20px), transparent 100%);
    -webkit-mask-image:
      linear-gradient(to top, transparent 0px, transparent 20px, black 40px, black calc(100% - 40px), transparent calc(100% - 20px), transparent 100%),
      linear-gradient(to left, transparent 0px, transparent 20px, black 40px, black calc(100% - 40px), transparent calc(100% - 20px), transparent 100%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  /* Края фото плавно переходят под фон — без видимой границы, небольшая глубина перехода */
  .hero-image-edge-blend {
    background: radial-gradient(
      ellipse 92% 88% at 50% 50%,
      transparent 78%,
      color-mix(in srgb, var(--color-light-bg) 40%, transparent) 90%,
      color-mix(in srgb, var(--color-light-bg) 85%, var(--color-warm-bg)) 100%
    );
  }

  /* Мягкий край без контура — маска на контейнере фото */
  .hero-image-mask {
    mask-image: radial-gradient(
      ellipse 92% 88% at 50% 50%,
      black 80%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 92% 88% at 50% 50%,
      black 80%,
      transparent 100%
    );
  }

  /* Без видимой границы, фото/видео сливается с секцией */
  .hero-image-no-border {
    border: none;
    outline: none;
    box-shadow: none;
  }

  /* Размытие по границам — только по краям, без жёсткой линии */
  .hero-image-edge-blur {
    mask-image: radial-gradient(
      ellipse 88% 85% at 50% 50%,
      transparent 60%,
      black 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 88% 85% at 50% 50%,
      transparent 60%,
      black 100%
    );
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .about-overlay {
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.2) 100%);
  }

  .testimonial-card {
    width: 380px;
    min-width: 320px;
    min-height: 180px;
    box-shadow: 0 4px 20px rgba(47, 52, 64, 0.12);
  }
}


@keyframes scroll-horizontal {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(calc(-100% / 2));
  }
}

.animate-scroll-infinite {
  animation: scroll-horizontal 20s linear infinite;
  display: flex;
  width: 200%;
  will-change: transform;
}
